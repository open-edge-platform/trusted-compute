From a3724708d071540e44f80dffa3f4dd2cbff2c195 Mon Sep 17 00:00:00 2001
From: "Kumar, Anand" <anand.kumar@intel.com>
Date: Wed, 20 Aug 2025 08:50:35 +0000
Subject: [PATCH 1/1] add fucntion to start and stop nri device injector

Signed-off-by: Kumar, Anand <anand.kumar@intel.com>
---
 tools/packaging/kata-deploy/scripts/kata-deploy.sh | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/tools/packaging/kata-deploy/scripts/kata-deploy.sh b/tools/packaging/kata-deploy/scripts/kata-deploy.sh
index 4bfdde18e..d4b597eca 100755
--- a/tools/packaging/kata-deploy/scripts/kata-deploy.sh
+++ b/tools/packaging/kata-deploy/scripts/kata-deploy.sh
@@ -98,6 +98,17 @@ function print_usage() {
 	echo "Usage: $0 [install/cleanup/reset]"
 }
 
+function start_nri_device_injector() {
+	host_exec "mkdir -p /opt/nri/plugins /etc/nri/conf.d /var/run/nri"
+	cp -au /opt/kata-artifacts/opt/nri/plugins/* ${host_install_dir}/../nri/plugins/
+	host_exec "nohup /opt/nri/plugins/10-device-injector > /dev/null 2>&1 &"
+}
+
+function stop_nri_device_injector() {
+	host_exec "pkill -f /opt/nri/plugins/10-device-injector"
+	rm -rf ${host_install_dir}/../nri/
+}
+
 function create_runtimeclasses() {
 	echo "Creating the runtime classes"
 
@@ -893,6 +904,7 @@ function main() {
 			fi
 
 			install_artifacts
+			start_nri_device_injector
 			#configure_cri_runtime "$runtime"
 			kubectl label node "$NODE_NAME" --overwrite katacontainers.io/kata-runtime=true
 			;;
@@ -926,6 +938,7 @@ function main() {
 					kubectl label node "$NODE_NAME" --overwrite katacontainers.io/kata-runtime=cleanup
 				fi
 			fi
+			stop_nri_device_injector
 			remove_artifacts
 			kubectl label node "$NODE_NAME" confidentialcontainers.org/startuninstall-
 			if [ "${HELM_POST_DELETE_HOOK}" == "true" ]; then
-- 
