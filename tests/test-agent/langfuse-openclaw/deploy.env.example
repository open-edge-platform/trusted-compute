# Langfuse files default to ./langfuse beside deploy.sh.
LANGFUSE_DIR=/path/to/trusted-compute/tests/test-agent/langfuse-openclaw/langfuse
PLUGIN_DIR=/path/to/trusted-compute/tests/test-agent/langfuse-openclaw/openclaw-x-langfuse-plugin

# This URL must be reachable from the OpenClaw gateway host.
LANGFUSE_BASE_URL=http://localhost:3000

# Used only when the Langfuse .env file is first generated.
LANGFUSE_ADMIN_EMAIL=admin@example.com
LANGFUSE_ADMIN_NAME=OpenClaw Admin
# LANGFUSE_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional source overrides.
LANGFUSE_COMPOSE_URL=https://raw.githubusercontent.com/langfuse/langfuse/main/docker-compose.yml
PLUGIN_REPOSITORY=https://github.com/langfuse/openclaw-x-langfuse-plugin.git
