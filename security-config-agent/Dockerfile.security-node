ARG OPENCLAW_IMAGE
FROM ghcr.io/oras-project/oras:v1.2.0@sha256:0087224dd0decc354b5b0689068fbbc40cd5dc3dbf65fcb3868dfbd363dc790b AS oras-cli

FROM ${OPENCLAW_IMAGE}

USER root

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      cryptsetup \
      dmsetup \
      docker.io \
      kmod \
      mokutil \
      msr-tools \
      sudo \
      tpm2-tools \
      util-linux && \
    rm -rf /var/lib/apt/lists/*

COPY --from=oras-cli /bin/oras /usr/local/bin/oras

RUN printf 'root ALL=(ALL:ALL) NOPASSWD: ALL\n' >/etc/sudoers.d/openclaw-security-node && \
    chmod 0440 /etc/sudoers.d/openclaw-security-node

ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

USER root
