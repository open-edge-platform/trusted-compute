#
# Start the NPU telemetry collector the moment an NPU accel device appears in
# the VM (e.g. when the NPU is VFIO-hotplugged into the kata guest after boot).
#
# Install into the kata guest rootfs at:
#   /etc/udev/rules.d/90-npu-telemetry.rules
#
# This handles hotplug *timing*: the guest may boot before the NPU is attached,
# so instead of a one-shot boot check we let udev trigger systemd on device add.

ACTION=="add", SUBSYSTEM=="accel", KERNEL=="accel*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="npu-telemetry.service"
