#
# Systemd service for the NPU telemetry agent inside a kata-container guest.
#
# Installed in the guest rootfs at:
#   /usr/lib/systemd/system/npu-telemetry.service


[Unit]
Description=Intel NPU telemetry collector (kata guest)
After=kata-agent.service
Wants=kata-agent.service
ConditionPathExistsGlob=/dev/accel/accel*

[Service]
Type=simple
RuntimeDirectory=npu-telemetry
RuntimeDirectoryMode=0755
EnvironmentFile=-/etc/npu-telemetry/npu-telemetry.env
ExecStart=/usr/local/bin/npu-telemetry-agent.sh
Restart=on-failure
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=kata-containers.target
