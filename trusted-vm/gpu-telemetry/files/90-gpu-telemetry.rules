#
# Start the GPU telemetry collector the moment a GPU render node appears in the
# VM (e.g. when the GPU is VFIO-hotplugged into the kata guest after boot).
#
# Install into the kata guest rootfs at:
#   /etc/udev/rules.d/90-gpu-telemetry.rules
#
# This handles hotplug *timing*: the guest may boot before the GPU is attached,
# so instead of a one-shot boot check we let udev trigger systemd on device add.

ACTION=="add", SUBSYSTEM=="drm", KERNEL=="renderD*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="gpu-telemetry.service"
