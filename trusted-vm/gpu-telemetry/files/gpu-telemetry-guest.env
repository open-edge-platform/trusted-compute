#
# Config for gpu-telemetry.service. Installed in guest at:
#   /etc/gpu-telemetry/gpu-telemetry.env
#
# Point PUSH_HOST/PUSH_PORT/PUSH_PATH at any HTTP listener that accepts
# InfluxDB line protocol (Telegraf, VictoriaMetrics, InfluxDB, etc.).
# Leave PUSH_HOST empty to disable telemetry collection.
PUSH_HOST=
PUSH_PORT=8186
PUSH_PATH=/write
COLLECT_INTERVAL_MS=1000
QMASSA_BIN=/usr/local/bin/qmassa
JQ_BIN=/usr/local/bin/jq
